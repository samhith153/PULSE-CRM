# PULSE AI Service environment configuration
# Copy to .env and fill in values.

# ── App ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
AI_SERVICE_PORT=8001
HOST=0.0.0.0

# ── LLM (Conversation AI) ─────────────────────────────────────────────────
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800
MIN_CONFIDENCE_THRESHOLD=0.3
MAX_RETRIES=1
