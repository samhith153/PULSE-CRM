# =============================================================================
# PULSE CRM — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Variables marked [required] must be set for the app to start.
# All others have sensible defaults for local development.

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Database [required] ──────────────────────────────────────────────────────
DATABASE_URL=
DATABASE_POOL_SIZE=25
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=20
DATABASE_POOL_RECYCLE=300

# ── Security [required] ──────────────────────────────────────────────────────
SECRET_KEY=

# ── Rate Limiting ────────────────────────────────────────────────────────────
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=200
AUTH_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_BURST=10
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=5
PASSWORD_RESET_RATE_LIMIT_BURST=3

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── First Superuser ──────────────────────────────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@kalnet-pulse.com
FIRST_SUPERUSER_PASSWORD=Admin@123456
FIRST_SUPERUSER_FULL_NAME=System Administrator

# ── SMTP / Email ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@kalnet-pulse.com
SMTP_FROM_NAME=KALNET PULSE CRM
SMTP_TLS=true
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback
GOOGLE_REFRESH_TOKEN=

# ── Gmail Pub/Sub ────────────────────────────────────────────────────────────
GMAIL_TOKEN_ENCRYPTION_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=

# ── Supabase (optional — document storage) ───────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── AI / LLM ─────────────────────────────────────────────────────────────────
ENABLE_AI=true
AI_PROVIDER=rule_based
SCORING_PROVIDER=rule_based
AI_TIMEOUT=30
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=30.0
GROQ_API_KEY=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=

# ── AI Service (port config) ─────────────────────────────────────────────────
PORT=8001
HOST=0.0.0.0
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
SUMMARIZATION_API_KEY=

# ── Redis (optional — rate limiting) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=uploads
MAX_UPLOAD_SIZE_BYTES=10485760
