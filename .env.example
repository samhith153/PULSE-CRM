# =============================================================================
# PULSE CRM — Single Global .env
# Copy to backend/.env, ai-service/.env and fill in your values.
# DO NOT commit real secrets. Use placeholders only.
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL: Use port 6543 (transaction pooler) for app runtime
# DIRECT_URL:   Use port 5432 (direct connection) for alembic migrations
DATABASE_URL=
DIRECT_URL=
DATABASE_POOL_SIZE=25
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=20
DATABASE_POOL_RECYCLE=300

# ── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ── Rate Limiting ────────────────────────────────────────────────────────────
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=200
AUTH_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_BURST=10
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=5
PASSWORD_RESET_RATE_LIMIT_BURST=3

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── First Superuser ──────────────────────────────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=
FIRST_SUPERUSER_FULL_NAME=System Administrator

# ── SMTP / Email ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=PULSE CRM
SMTP_TLS=true
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback
GOOGLE_REFRESH_TOKEN=

# ── Gmail Pub/Sub ────────────────────────────────────────────────────────────
GMAIL_TOKEN_ENCRYPTION_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=

# ── Supabase (optional — document storage) ───────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend (port config) ────────────────────────────────────────────────────
BACKEND_PORT=8000
HOST=0.0.0.0

# ── AI / LLM ─────────────────────────────────────────────────────────────────
ENABLE_AI=true
AI_PROVIDER=rule_based
SCORING_PROVIDER=rule_based
AI_TIMEOUT=30
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT=30.0
GROQ_API_KEY=
ASSISTANT_API_KEY=
ASSISTANT_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=

# ── AI Service (port config) ─────────────────────────────────────────────────
AI_SERVICE_PORT=8001
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
SUMMARIZATION_API_KEY=

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=uploads
MAX_UPLOAD_SIZE_BYTES=10485760
