# ========================================
# PULSE CRM - Environment Variables
# ========================================

# --- Database ---
# Used in: backend/app/core/config.py, alembic/, tests/
# Transaction-mode pooler (port 6543) — allows up to ~200 concurrent connections.
# Do NOT use session-mode (port 5432) unless you need session-level features;
# it caps at 15 connections and will cause EMAXCONNSESSION under load.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres

# --- Authentication ---
# Used in: backend/app/core/security.py
SECRET_KEY=change-me-generate-a-long-random-value
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Conversation Intelligence / Summarization (LLM) ---
# Used in: backend/ai/summarization/src/config.py
SUMMARIZATION_API_KEY=grok_API_key
SUMMARIZATION_MODEL=llama-3.3-70b-versatile
SUMMARIZATION_TEMPERATURE=0.3
SUMMARIZATION_MAX_TOKENS=200

# --- Supabase (optional) ---
# Used in: backend/app/core/config.py, backend/ai/summarization/src/config.py
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# --- Redis Cache (optional) ---
# Used in: backend/ai/summarization/src/cache.py
REDIS_URL=redis://localhost:6379

# --- Logging ---
# Used in: backend/app/core/config.py
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Rate Limiting ---
# Used in: backend/app/middlewares/rate_limit.py
# ENABLE_RATE_LIMIT=true
# RATE_LIMIT_PER_MINUTE=600
# RATE_LIMIT_BURST=120

#Email configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@kalnet-pulse.com
SMTP_FROM_NAME=KALNET PULSE CRM
SMTP_TLS=true

# --- Frontend ---
# Used in: frontend/src/utils/api.ts, frontend/playwright.config.ts
NEXT_PUBLIC_API_URL=http://localhost:8000 
# For Vercel production deployment, set this to your deployed Render backend URL https://pulse-crm-245t.onrender.com

# --- Optional AI Providers ---
# Used in: backend/app/core/config.py (if AI_PROVIDER is set to openai)
OPENAI_API_KEY=
