# ========================================
# PULSE CRM - Environment Variables
# ========================================

# --- Database ---
# Used in: backend/app/core/config.py, alembic/, tests/
DATABASE_URL=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=pulsecrmteam123

#postgresql+asyncpg://pulse:pulse@localhost:5432/pulse_crm

# --- Authentication & Google OAuth ---
# Used in: backend/app/core/security.py, backend/scripts/seed.py
SECRET_KEY=

# Google OAuth for Admin-only login
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_AUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# Google Gmail Integration (separate from auth)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/oauth/callback
GOOGLE_REFRESH_TOKEN=

# --- Conversation Intelligence / Summarization (LLM) ---
# Used in: backend/ai/summarization/src/config.py
SUMMARIZATION_API_KEY=
ASSISTANT_API_KEY=
SUMMARIZATION_MODEL=llama-3.3-70b-versatile
SUMMARIZATION_TEMPERATURE=0.3
SUMMARIZATION_MAX_TOKENS=200

# --- Supabase (optional) ---
# Used in: backend/app/core/config.py, backend/ai/summarization/src/config.py

SUPABASE_SERVICE_KEY=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

SUPABASE_URL=
SUPABASE_KEY=
# --- Redis Cache (optional) ---
# Used in: backend/ai/summarization/src/cache.py
REDIS_URL=redis://localhost:6379

# --- Logging ---
# Used in: backend/app/core/config.py
LOG_LEVEL=INFO

#Email configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@kalnet-pulse.com
SMTP_FROM_NAME=KALNET PULSE CRM
SMTP_TLS=true
BREVO_API_KEY=
# --- Frontend ---
# Used in: frontend/src/utils/api.ts, frontend/playwright.config.ts
NEXT_PUBLIC_API_URL=http://localhost:8000 
# For Vercel production deployment, set this to your deployed Render backend URL https://pulse-crm-245t.onrender.com

# --- Optional AI Providers ---
# Used in: backend/app/core/config.py (if AI_PROVIDER is set to openai)
OPENAI_API_KEY=





